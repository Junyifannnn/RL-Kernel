+def _token_id_from_logprob_entry(entry: dict[str, Any]) -> int:
+    token = entry.get("token")
+    if not isinstance(token, str) or not token.startswith("token_id:"):
+        raise RuntimeError(f"unexpected tokens API logprob token {token!r}")
+    return int(token.removeprefix("token_id:"))
+
