+                active[start:start + logits[half][1] - logits[half][0]] = True
+            offset += 2 * size
+    else:
+        local_start = mpu.get_context_parallel_rank() * T if allgather_cp else 0
+        for total, response in zip(total_lengths, response_lengths, strict=True):
+            start = max(0, offset + total - response - 1 - local_start)
+            end = min(T, offset + total - 1 - local_start)
+            if end > start:
+                active[start:end] = True
+            offset += total
+    return active
