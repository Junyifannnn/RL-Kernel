+def _top_p_replay_from_logprobs(
+    content_items: list[Any],
+    *,
+    expected_tokens: int,
+) -> tuple[list[int], list[int]]:
+    if len(content_items) != expected_tokens:
+        raise RuntimeError(
+            "top-p replay logprob rows do not match generated tokens: "
+            f"{len(content_items)} != {expected_tokens}"
+        )
+    token_ids: list[int] = []
+    offsets = [0]
+    for item in content_items:
+        if not isinstance(item, dict):
+            raise RuntimeError("top-p replay logprob row must be an object")
+        retained: dict[int, float] = {}
+        for entry in [item, *(item.get("top_logprobs") or [])]:
+            if not isinstance(entry, dict):
+                continue
+            logprob = float(entry.get("logprob", float("-inf")))
+            if not math.isfinite(logprob) or logprob <= -9990.0:
+                continue
+            retained[_token_id_from_logprob_entry(entry)] = logprob
+        probability_mass = math.fsum(math.exp(value) for value in retained.values())
+        if not math.isclose(probability_mass, 1.0, rel_tol=0.0, abs_tol=2e-4):
+            raise RuntimeError(
+                "top-p nucleus exceeds the compact replay capacity or is incomplete: "
+                f"retained={len(retained)}, probability_mass={probability_mass:.8f}"
+            )
+        token_ids.extend(sorted(retained))
+        offsets.append(len(token_ids))
+    return token_ids, offsets
+
